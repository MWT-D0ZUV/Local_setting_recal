{
  "manifest_version": 2,
  "id": "Local.setting_recall",
  "name": "设定与风格自动召回",
  "version": "1.1.2",
  "description": "手动勾选加载本地文档，按真人文本消息批次检索并持久去重；支持宿主 embedding、关键词回退和独立管理页。",
  "author": {
    "name": "Local user (AI-assisted)",
    "url": "https://github.com/MWT-D0ZUV/Local_setting_recal"
  },
  "license": "MIT",
  "urls": {
    "repository": "https://github.com/MWT-D0ZUV/Local_setting_recal"
  },
  "host_application": {
    "min_version": "1.3.18",
    "max_version": "1.3.99"
  },
  "sdk": {
    "min_version": "2.19.0",
    "max_version": "2.21.0"
  },
  "dependencies": [],
  "capabilities": [
    "knowledge.search",
    "message.get_recent",
    "message.get_by_time_in_chat",
    "config.get",
    "llm.embed"
  ],
  "i18n": {
    "default_locale": "zh-CN",
    "supported_locales": [
      "zh-CN"
    ]
  }
}
